# Public host name; DNS must point to this server (ports 80 and 443 open).
DOMAIN=wedding.example.com
# At least 16 characters, e.g. `openssl rand -base64 32`. Keep it stable.
SESSION_SECRET=
# Image tag, e.g. 0.2.0
WEDWISE_VERSION=latest
# Optional OpenRouteService key for walking/bike/car routes
ROUTING_API_KEY=
